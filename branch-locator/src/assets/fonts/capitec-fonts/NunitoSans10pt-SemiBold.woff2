<div class="nav-card__wrapper">
        <div class="nav-card__title">Switch</div>
    <div class="nav-card">
        <div class="nav-card__image-wrapper nav--mobile-only">
            <img 
                class="nav-card__image" 
                loading="lazy" 
                src="/globalassets/fee_calculator_desktop.jpg"
                alt="fee_calculator_desktop" 
            />
                <div class="nav-card__heading nav-card__heading--light">Bank on our app</div>
        </div>
            <div class="nav-card__heading nav-card__heading--desktop nav--desktop-only">Bank on our app</div>
        <div class="nav-card__body nav-card--h-padding-equal">
            <p class="nav-card__paragraph">
                

Pay people and accounts, make immediate payments, get credit and more without having to visit a branch.


            </p>
            <div class="nav-card__buttons">
                        <a 
                            href="/personal/transact/switch-to-capitec/"
                            class="btn button--v2 button--v2--small button--v2--secondary"
