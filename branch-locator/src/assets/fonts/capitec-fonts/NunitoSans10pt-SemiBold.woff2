<!-- Modal containing secondary navigation, tertiary navigation and navigation cards -->
<div id="navModal" class="modal fade nav-modal" tabindex="-1" role="dialog" data-backdrop="false">
    <div id="navModalDialog" class="modal-dialog nav-modal__dialog">
        <div id="navModalContent" class="modal-content nav-modal__content">
            <div id="navModalBody" class="modal-body nav-modal__body">
                <!--  Only for MOBILE -->
                <div class="nav-modal__title nav--mobile-only">
                        <span>Welcome to Capitec Personal Banking</span>
                </div>

