                            aria-label="Sub Navigation Switch to Capitec"
                            rel="">
                            Switch to Capitec
                        </a>
                        <a 
                            href="/personal/transact/cellphone-app/"
                            class="btn button--v2 button--v2--small button--v2--primary"
                            role="button"
                            aria-label="Sub Navigation Get the app"
                            rel="">
                            Get the app
                        </a>
            </div>
        </div>
    </div>
</div>



<div class="nav-card__wrapper image">
        <div class="nav-card__title">Apply</div>
    <div class="nav-card">
        <div class="nav-card__image-wrapper">
            <img 
                class="nav-card__image" 
                loading="lazy" 
                src="/globalassets/approved-images/credit/creditcard_2023---mobile.png"
                alt="CreditCard_2023 - Mobile" 
            />
